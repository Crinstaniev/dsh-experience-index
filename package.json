{
  "name": "dsh-experience-index",
  "version": "0.1.0",
  "description": "Signpost experience files left by earlier agent sessions, so a new DeepSeek Harness session knows what already exists.",
  "license": "MIT",
  "author": "Crinstaniev",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agents",
    "context",
    "codex",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crinstaniev/dsh-experience-index.git"
  },
  "homepage": "https://github.com/Crinstaniev/dsh-experience-index#readme",
  "bugs": {
    "url": "https://github.com/Crinstaniev/dsh-experience-index/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node scripts/build-client.mjs && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "zod": "^4.0.0",
    "esbuild": "^0.28.0"
  }
}
